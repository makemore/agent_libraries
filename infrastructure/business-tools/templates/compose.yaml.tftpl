# All fragments are merged by runtime/compose.sh. No app publishes host ports.
services:
  caddy:
    image: "${images.caddy}"
    networks:
      edge: {}
      mautic-proxy:
        ipv4_address: 172.30.251.2
      invoice-render:
        ipv4_address: 172.30.252.2
        aliases: ["${domains.invoices}"]
    ports:
      - "80:80"
      - "443:443"
      # Private HTTPS setup bypass, reachable through IAP SSH only.
      - "127.0.0.1:8443:8443"
    read_only: true
    cap_drop: [ALL]
    cap_add: [NET_BIND_SERVICE]
    security_opt: [no-new-privileges:true]
    volumes:
      - type: bind
        source: /opt/business-tools/Caddyfile
        target: /etc/caddy/Caddyfile
        read_only: true
        bind:
          create_host_path: false
      - type: bind
        source: /srv/business-tools/caddy/data
        target: /data
        bind:
          create_host_path: false
      - type: bind
        source: /srv/business-tools/caddy/config
        target: /config
        bind:
          create_host_path: false
    tmpfs: [/tmp]
    mem_limit: 256m
    pids_limit: 128
    logging:
      driver: local
      options:
        max-size: "10m"
        max-file: "3"

# Shared-host resource/log policy. The per-app files supply app behavior.
%{ for name, memory in { postiz = "2048m", postiz-postgres = "768m", postiz-redis = "256m", postiz-temporal = "1024m", postiz-temporal-postgres = "768m", mautic = "1536m", mautic-cron = "768m", mautic-worker = "768m", mautic-mariadb = "1024m", actual = "512m", invoice-ninja = "128m", invoice-app = "2048m", invoice-db = "1024m", invoice-redis = "256m", grafana = "512m", prometheus = "768m", node-exporter = "128m" } ~}
  ${name}:
    mem_limit: ${memory}
    pids_limit: 512
    logging:
      driver: local
      options:
        max-size: "10m"
        max-file: "3"
%{ endfor ~}

networks:
  edge:
    driver: bridge