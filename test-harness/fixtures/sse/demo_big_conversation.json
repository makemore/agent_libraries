              { "label": "Rating", "value": "4.7 ★ (1,204 reviews)" },
              { "label": "Wifi",   "value": "Included" }
            ],
            "actions": [
              { "type": "link", "label": "View on Booking", "url": "https://example.com/hotel/1", "style": "primary" }
            ]
          },
          { "type": "actionButtons", "buttons": [
              { "type": "callback", "label": "Book this hotel",   "callbackId": "book_hotel_1", "style": "primary"  },
              { "type": "callback", "label": "Show alternatives", "callbackId": "more_hotels",  "style": "secondary"},
              { "type": "link",     "label": "Map directions",    "url": "https://maps.example/?q=Shibuya+Sky" }
          ]}
        ]
