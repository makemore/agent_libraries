    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": " — central, well reviewed, fits your dates." } },
    { "delay_ms": 70,   "event": "assistant.message", "payload": { "role": "assistant", "content": "I'd grab this one — central, well reviewed, fits your dates." } },
    { "delay_ms": 300,  "event": "sub_agent.end",     "payload": { "sub_agent_key": "sai_booking", "agent_name": "Booking Specialist" } },

    { "delay_ms": 600,  "event": "assistant.delta",   "payload": { "delta": "Great. Last step:" } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": " let me hand off to the itinerary writer." } },
    { "delay_ms": 80,   "event": "assistant.message", "payload": { "role": "assistant", "content": "Great. Last step: let me hand off to the itinerary writer." } },

    { "delay_ms": 500,  "event": "sub_agent.start",   "payload": { "sub_agent_key": "sai_writer", "agent_name": "Itinerary Writer", "invocation_mode": "handoff" } },

    { "delay_ms": 80,   "event": "assistant.delta",   "payload": { "delta": "Here's a 3-day plan you can actually follow.\n\n" } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": "**Day 1 — Shibuya & Harajuku.** " } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": "Land, drop bags, grab tonkatsu for lunch, " } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": "walk Takeshita-dori, finish at Shibuya Sky for sunset.\n\n" } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": "**Day 2 — Asakusa & Sumida.** " } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": "Senso-ji at opening, Nakamise snacks, " } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": "river boat to Hamarikyu Gardens, dinner in Shimbashi.\n\n" } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": "**Day 3 — Toyosu & Ginza.** " } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": "teamLab Planets in the morning, sushi at Toyosu, " } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": "Ginza in the afternoon for shopping and coffee." } },
    { "delay_ms": 100,  "event": "assistant.message", "payload": { "role": "assistant", "content": "Here's a 3-day plan you can actually follow.\n\n**Day 1 — Shibuya & Harajuku.** Land, drop bags, grab tonkatsu for lunch, walk Takeshita-dori, finish at Shibuya Sky for sunset.\n\n**Day 2 — Asakusa & Sumida.** Senso-ji at opening, Nakamise snacks, river boat to Hamarikyu Gardens, dinner in Shimbashi.\n\n**Day 3 — Toyosu & Ginza.** teamLab Planets in the morning, sushi at Toyosu, Ginza in the afternoon for shopping and coffee." } },

    { "delay_ms": 400,  "event": "content.blocks",    "payload": {
        "blocks": [
          { "type": "collapsible", "title": "Day-by-day breakdown", "expanded": false, "body": "Day 1: Shibuya 09:00, Harajuku 13:00, Shibuya Sky 17:30.\nDay 2: Senso-ji 08:30, Hamarikyu 13:00, Shimbashi dinner 19:00.\nDay 3: teamLab 09:00, Toyosu sushi 12:30, Ginza 15:00." },
          { "type": "code", "language": "markdown", "code": "# Tokyo packing list\n- Pocket wifi or eSIM\n- Comfortable walking shoes\n- Small umbrella (sudden rain)\n- Cash (¥10,000) — many places still card-shy\n- IC card (Suica / Pasmo)" },
          { "type": "divider" }
        ]
      }
    },
    { "delay_ms": 300,  "event": "sub_agent.end",     "payload": { "sub_agent_key": "sai_writer", "agent_name": "Itinerary Writer" } },

    { "delay_ms": 700,  "event": "assistant.delta",   "payload": { "delta": "That's the plan." } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": " Want me to lock in the hotel and add" } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": " these to your calendar?" } },
    { "delay_ms": 100,  "event": "assistant.message", "payload": { "role": "assistant", "content": "That's the plan. Want me to lock in the hotel and add these to your calendar?" } },

    { "delay_ms": 300,  "event": "content.blocks",    "payload": {
        "blocks": [
          { "type": "callout", "style": "success", "title": "Trip ready",
            "body": "3 days · 1 hotel · 5 attractions · packing list included." },
          { "type": "actionButtons", "buttons": [
