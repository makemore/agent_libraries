    { "delay_ms": 1500, "event": "tool.result",       "payload": { "tool_call_id": "call_book_001", "name": "find_hotels", "result": { "status": "ok", "hotels": 1 } } },
    { "delay_ms": 200,  "event": "content.blocks",    "payload": {
        "tool_call_id": "call_book_001",
