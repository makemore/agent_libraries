{
  "name": "demo_big_conversation",
  "description": "Long, slow-paced fixture for hand-watching the streaming UI. One user turn (\"plan a 3-day trip to Tokyo\") triggers a S'Ai-style multi-agent run with three sub-agents (Researcher, Booking, Itinerary Writer) and exercises most of the content-block renderers (callout, cardList, table, status, card, actionButtons, collapsible, code, divider). Chains into demo_followup_1 / demo_followup_2 so the host app can demonstrate multi-turn user follow-ups. Not for CI.",
  "run_id": "demo-trip-run-001",
  "conversation_id": "demo-trip-conv-001",
  "next_fixture": "demo_followup_1",
  "events": [
    { "delay_ms": 600,  "event": "assistant.delta",   "payload": { "delta": "Sounds great" } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": " — let me put my team on this" } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": " and pull together a real itinerary." } },
    { "delay_ms": 80,   "event": "assistant.message", "payload": { "role": "assistant", "content": "Sounds great — let me put my team on this and pull together a real itinerary." } },

    { "delay_ms": 500,  "event": "sub_agent.start",   "payload": { "sub_agent_key": "sai_researcher", "agent_name": "Tokyo Researcher", "invocation_mode": "handoff" } },

    { "delay_ms": 80,   "event": "assistant.delta",   "payload": { "delta": "Hi! I'll dig up" } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": " the best neighbourhoods" } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": " and headline attractions for you." } },
    { "delay_ms": 80,   "event": "assistant.message", "payload": { "role": "assistant", "content": "Hi! I'll dig up the best neighbourhoods and headline attractions for you." } },

    { "delay_ms": 350,  "event": "tool.call",         "payload": { "id": "call_research_001", "name": "search_destinations", "arguments": "{\"city\":\"Tokyo\",\"days\":3}" } },
    { "delay_ms": 1200, "event": "tool.result",       "payload": { "tool_call_id": "call_research_001", "name": "search_destinations", "result": { "status": "ok", "neighborhoods": 4, "attractions": 5 } } },
    { "delay_ms": 200,  "event": "content.blocks",    "payload": {
        "tool_call_id": "call_research_001",
        "tool_name": "search_destinations",
        "blocks": [
          { "type": "callout", "style": "info", "title": "Did you know?", "body": "Tokyo's metro carries over 8 million riders a day — buying a Suica card on arrival is the single biggest time-saver." },
          { "type": "cardList", "layout": "vertical", "items": [
              { "type": "card", "title": "Shibuya",  "subtitle": "Energetic, neon, food", "badge": "Stay nearby" },
              { "type": "card", "title": "Asakusa",  "subtitle": "Traditional, temples",   "badge": "Day 2" },
              { "type": "card", "title": "Shinjuku", "subtitle": "Skyline + nightlife",    "badge": "Evening" },
              { "type": "card", "title": "Harajuku", "subtitle": "Fashion + Meiji Shrine"                       }
          ]},
          { "type": "table",
            "headers": ["Attraction", "Neighbourhood", "Time"],
            "rows": [
              ["Senso-ji Temple",       "Asakusa",  "1.5 h"],
              ["Shibuya Crossing",      "Shibuya",  "0.5 h"],
              ["Meiji Shrine",          "Harajuku", "1.0 h"],
              ["Tokyo Skytree",         "Sumida",   "2.0 h"],
              ["teamLab Planets",       "Toyosu",   "2.5 h"]
            ]
          }
        ]
      }
    },
    { "delay_ms": 250,  "event": "assistant.delta",   "payload": { "delta": "Those should give you" } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": " a good geographic spread." } },
    { "delay_ms": 70,   "event": "assistant.message", "payload": { "role": "assistant", "content": "Those should give you a good geographic spread." } },
    { "delay_ms": 300,  "event": "sub_agent.end",     "payload": { "sub_agent_key": "sai_researcher", "agent_name": "Tokyo Researcher" } },

    { "delay_ms": 600,  "event": "assistant.delta",   "payload": { "delta": "Nice. Now let me get someone" } },
    { "delay_ms": 70,   "event": "assistant.delta",   "payload": { "delta": " to look at where you'll stay." } },
    { "delay_ms": 80,   "event": "assistant.message", "payload": { "role": "assistant", "content": "Nice. Now let me get someone to look at where you'll stay." } },

    { "delay_ms": 500,  "event": "sub_agent.start",   "payload": { "sub_agent_key": "sai_booking", "agent_name": "Booking Specialist", "invocation_mode": "handoff" } },

    { "delay_ms": 80,   "event": "assistant.delta",   "payload": { "delta": "On it." } },
