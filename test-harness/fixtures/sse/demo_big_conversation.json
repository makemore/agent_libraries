              { "type": "callback", "label": "Tweak the itinerary", "callbackId": "edit_trip",        "style": "secondary"},
              { "type": "callback", "label": "Start over",         "callbackId": "restart_planning", "style": "destructive"}
          ]}
        ]
      }
